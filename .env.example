# Required in production — without it, a random key is generated on every
# restart, which logs everyone out each time the app restarts.
SECRET_KEY=change-this-to-a-random-secret-string

# ---------------------------------------------------------------------------
# AI-powered SQL generation (optional)
#
# Set ONE of the keys below to have a model write the SQL. With neither set,
# the app falls back to its rule-based engines and every feature still works —
# no key is ever required.
#
# Whatever the model returns is validated before it runs: a single read-only
# SELECT against a whitelist of tables. See backend/engines/ai_engine.py.
# ---------------------------------------------------------------------------

# Google Gemini — get a key at https://aistudio.google.com/apikey
# (keys look like AIza... — GOOGLE_API_KEY works as an alias for this)
GEMINI_API_KEY=

# Anthropic Claude — get a key at https://console.anthropic.com/settings/keys
# (keys look like sk-ant-...)
ANTHROPIC_API_KEY=

# Which provider to use. Leave blank to pick automatically: Gemini if its key
# is set, otherwise Claude. Set it explicitly ("gemini" or "anthropic") when you
# keep both keys here but want to pin which one actually runs.
AI_PROVIDER=

# Model overrides — only needed to move to a newer model without a code change.
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Where the app keeps its own data: accounts, saved query history, the demo
# tables, and any CSV you upload.
#
# Unset  -> a SQLite file under DATA_DIR. Nothing to install; right for local use.
# Set    -> that PostgreSQL database instead. Required on any host without a
#           persistent disk (anything serverless, Vercel included), because a
#           SQLite file there is wiped on every restart.
#
# Free options: neon.tech, supabase.com. Use the *pooled* connection string if
# the provider offers one - serverless opens a new connection per request.
# ---------------------------------------------------------------------------
DATABASE_URL=

# Overrides where the SQLite file and uploaded files are written. Only needed on
# a host whose deployment directory is read-only; Vercel sets this to /tmp in
# vercel.json.
# DATA_DIR=

# ---------------------------------------------------------------------------

# Connecting to a PostgreSQL database on localhost or a private network is
# blocked by default: an app reachable by other people could otherwise be aimed
# at internal hosts and used to map the network behind it. Set this to true if
# you're running the database on this machine.
ALLOW_PRIVATE_DB_HOSTS=false

# The account allowed to read feedback at /feedback/all. Unset means nobody can —
# not everybody — so a deployment that forgets this shows it to no one rather than
# to whoever signs up first.
ADMIN_USERNAME=

# Optional — set to true only for local development. Never enable in
# production: Flask's debugger allows arbitrary code execution if exposed.
FLASK_DEBUG=false

# Optional — set to true once the app is served over HTTPS, so session
# cookies are marked Secure. Leave false for local http:// development.
SESSION_COOKIE_SECURE=false
